<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Generator ponuda</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fa;
            color: #172033;
        }

        header {
            background: #172033;
            color: white;
            padding: 45px 20px;
            text-align: center;
        }

        header h1 {
            margin: 0;
            font-size: 38px;
        }

        header p {
            margin-top: 10px;
            color: #cbd5e1;
        }

        main {
            max-width: 900px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .box {
            background: white;
            padding: 25px;
            margin-bottom: 20px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

        h2 {
            margin-top: 0;
        }

        input {
            width: 100%;
            padding: 13px;
            margin-bottom: 12px;
            border: 1px solid #d5d9e0;
            border-radius: 8px;
            font-size: 15px;
        }

        .row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            gap: 10px;
        }

        button {
            border: none;
            padding: 13px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 15px;
        }

        .add {
            background: #2563eb;
            color: white;
        }

        .create {
            width: 100%;
            background: #172033;
            color: white;
            font-size: 17px;
        }

        .delete {
            background: #ef4444;
            color: white;
        }

        #offer {
            display: none;
        }

        .offer-header {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        .offer-item {
            padding: 12px 0;
            border-bottom: 1px solid #ddd;
        }

        .total {
            text-align: right;
            font-size: 25px;
            font-weight: bold;
            margin-top: 25px;
        }

        @media(max-width: 700px) {

            .row {
                grid-template-columns: 1fr;
            }

            .offer-header {
                display: block;
            }

            header h1 {
                font-size: 30px;
            }
        }

        @media print {

            header,
            .input-area,
            .print-button {
                display: none !important;
            }

            body {
                background: white;
            }

            main {
                max-width: 100%;
                margin: 0;
            }

            #offer {
                display: block !important;
            }

            .box {
                box-shadow: none;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Generator ponuda</h1>
    <p>Izradite profesionalnu ponudu u nekoliko klikova.</p>
</header>

<main>

    <div class="box input-area">

        <h2>Podaci vaše firme</h2>

        <input id="firma" placeholder="Naziv firme">
        <input id="adresa" placeholder="Adresa">
        <input id="telefon" placeholder="Telefon">
        <input id="email" placeholder="E-mail">

    </div>


    <div class="box input-area">

        <h2>Podaci klijenta</h2>

        <input id="klijent" placeholder="Ime / naziv klijenta">
        <input id="klijentAdresa" placeholder="Adresa klijenta">

    </div>


    <div class="box input-area">

        <h2>Usluge i proizvodi</h2>

        <div id="stavke"></div>

        <button class="add" onclick="dodajStavku()">
            + Dodaj stavku
        </button>

    </div>


    <div class="box input-area">

        <button class="create" onclick="napraviPonudu()">
            IZRADi PONUDU
        </button>

    </div>


    <div class="box" id="offer">

        <div class="offer-header">

            <div>
                <h2 id="oFirma">Naziv firme</h2>
                <p id="oAdresa"></p>
                <p id="oTelefon"></p>
                <p id="oEmail"></p>
            </div>

            <div>
                <strong>PONUDA</strong>
                <p id="datum"></p>
            </div>

        </div>

        <hr>

        <h3>Klijent</h3>

        <p id="oKlijent"></p>
        <p id="oKlijentAdresa"></p>

        <hr>

        <h3>Stavke</h3>

        <div id="oStavke"></div>

        <div class="total">
            UKUPNO: <span id="ukupno">0.00 €</span>
        </div>

        <br>

        <button
            class="create print-button"
            onclick="window.print()">
            Ispis / Spremi kao PDF
        </button>

    </div>

</main>


<script>

let brojStavki = 0;


function dodajStavku() {

    brojStavki++;

    const stavka = document.createElement("div");

    stavka.className = "row";

    stavka.id = "stavka-" + brojStavki;

    stavka.innerHTML = `
        <input class="naziv" placeholder="Naziv usluge">
        <input class="kolicina" type="number" value="1" min="1">
        <input class="cijena" type="number" value="0" min="0" step="0.01">

        <button
            class="delete"
            onclick="obrisiStavku(${brojStavki})">
            X
        </button>
    `;

    document.getElementById("stavke").appendChild(stavka);
}


function obrisiStavku(id) {

    const stavka =
        document.getElementById("stavka-" + id);

    if (stavka) {
        stavka.remove();
    }
}


function napraviPonudu() {

    document.getElementById("oFirma").textContent =
        document.getElementById("firma").value || "Naziv firme";

    document.getElementById("oAdresa").textContent =
        document.getElementById("adresa").value;

    document.getElementById("oTelefon").textContent =
        document.getElementById("telefon").value;

    document.getElementById("oEmail").textContent =
        document.getElementById("email").value;

    document.getElementById("oKlijent").textContent =
        document.getElementById("klijent").value || "Klijent";

    document.getElementById("oKlijentAdresa").textContent =
        document.getElementById("klijentAdresa").value;


    const nazivi =
        document.querySelectorAll(".naziv");

    const kolicine =
        document.querySelectorAll(".kolicina");

    const cijene =
        document.querySelectorAll(".cijena");

    const rezultat =
        document.getElementById("oStavke");

    rezultat.innerHTML = "";

    let ukupno = 0;


    for (let i = 0; i < nazivi.length; i++) {

        const naziv =
            nazivi[i].value || "Usluga";

        const kolicina =
            Number(kolicine[i].value) || 0;

        const cijena =
            Number(cijene[i].value) || 0;

        const iznos =
            kolicina * cijena;

        ukupno += iznos;


        const red =
            document.createElement("div");

        red.className = "offer-item";

        red.textContent =
            naziv +
            " — " +
            kolicina +
            " × " +
            cijena.toFixed(2) +
            " € = " +
            iznos.toFixed(2) +
            " €";

        rezultat.appendChild(red);
    }


    document.getElementById("ukupno").textContent =
        ukupno.toFixed(2) + " €";


    document.getElementById("datum").textContent =
        new Date().toLocaleDateString("hr-HR");


    document.getElementById("offer").style.display =
        "block";


    document.getElementById("offer").scrollIntoView({
        behavior: "smooth"
    });
}


dodajStavku();

</script>

</body>
</html>